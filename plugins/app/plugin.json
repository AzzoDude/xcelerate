{
  "name": "app",
  "version": "0.1.0",
  "host_api": ">=1.0 <2.0",
  "entrypoint": "app.wasm",
  "abi": "wasm32-wasip2/1",
  "ops": [
    "windows",
    "launch",
    "tree",
    "find",
    "wait",
    "click",
