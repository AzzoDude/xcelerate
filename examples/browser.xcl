# browser.xcl - drive a Chromium browser with the plain XCL browser verbs.
#
# The `browser` plugin backs these verbs; the browser is launched for you when a
# browser verb is first used (configure the launch with the environment):
#
#   XCELERATE_BROWSER=brave xcelerate run browser.xcl
#
# (The `browser` plugin exposes the same work as ops, e.g.
# `run browser open {"url":"..."}`.)

import browser
open "https://example.com"
assert url contains example.com

done
