# app-plugin.xcl - drive a native Windows app through the `xcelerate.app` plugin.
#
# The plugin owns the native-app API; every op forwards to the host's UI
# Automation bridge (`host.app`). It needs the `app` capability granted, and it
# runs with **no browser** at all (`--native`):
#
#   XCELERATE_PLUGIN_ALLOW=app \
#     xcelerate --plugins app run --native --allow-plugin xcelerate.app app-plugin.xcl
#
# Native *verbs* (`launch`, `window`, `tree`, `find`, `click`, ...) route through
# the same plugin, so this also works:
#
#   launch "calc" "Calculator"
#   find "Equals"

run xcelerate.app launch {"target":"calc","title":"Calculator"}
run xcelerate.app tree {"window":"Calculator"}
run xcelerate.app find {"window":"Calculator","text":"Equals"}

done
