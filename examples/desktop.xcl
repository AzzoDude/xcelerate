# desktop.xcl - drive a native Windows app with the plain native verbs.
#
# The `desktop` plugin backs these verbs (it talks to Windows UI Automation); you
# never name it in a script. It is a standard-library plugin, so it is loaded and
# trusted by default. The desktop driver is selected by the native verbs:
#
#   xcelerate run --allow-app "Calculator" desktop.xcl
#
# `launch` starts an app (or attaches to it if its window is already open) and
# selects it. `window "<title>"` selects an already-running window instead, which
# is how you focus a different app:
#
#   window "Calculator"

launch "calc" "Calculator"
find "Equals"
click "Equals"

done
