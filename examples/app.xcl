# app.xcl - drive a native Windows app with the plain native verbs.
#
# The `app` library backs these verbs (it talks to Windows UI
# Automation); you never name it in a script. It is loaded automatically when
# installed, and its capability is granted at invocation:
#
#   XCELERATE_PLUGIN_ALLOW=app \
#     xcelerate run --native --allow-app "Calculator" app.xcl
#
# `launch` starts an app (or attaches to it if its window is already open) and
# selects it. `window "<title>"` selects an already-running window instead, which
# is how you focus a different app:
#
#   window "Calculator"

launch "calc" "Calculator"
find "Equals"
click "Equals"

done
