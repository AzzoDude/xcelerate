# calculator-to-web.xcl - take a value computed in a native app and paste it into
# a web form.
#
# This is the cross-application flow XCL is built for: the browser and the
# desktop are both driven through their plugins, and a step's result is carried
# forward in `$RESULT` for the next steps to reuse.
#
#   XCELERATE_PLUGIN_ALLOW=core,browser,app \
#     xcelerate run --allow-plugin '*' --allow-app "Calculator" calculator-to-web.xcl
#
# The `core`, `browser`, and `app` plugins are auto-loaded when installed; each is
# a plugin like any other, and a script may `import` one and call its ops directly
# (`run app tree {"window":"Calculator"}`).

# 1) Browser: open a form and leave a placeholder. `import browser` makes the
#    browser the active driver, so the shared verbs (`fill`, `click`, …) act on it.
import browser
open "https://www.practicesoftwaretesting.com/contact"
fill "#message" "pending..."

# 2) Desktop: compute 7 x 6. `import desktop` makes the desktop the active driver,
#    and `launch` starts Calculator (or attaches to its window if already open).
import desktop
launch "calc" "Calculator"
click "Seven"
click "Multiply"
click "Six"
click "Equals"

# 3) Read the display. A browser/app verb leaves its result in `$RESULT`, so the
#    next steps can reuse it (the same convention `request` uses for `$STATUS`).
find "Display is"          # -> [..] <text> "Display is 42"

# 4) Back to the browser: paste what the calculator produced.
import browser
fill "#message" $RESULT

done
