    "WebElement": {
      "doc": "Selenium-style element.",
      "methods": [
        {
          "name": "click",
          "op": "element_click",
          "params": [],
          "returns": null
        },
        {
          "name": "send_keys",
          "op": "element_send_keys",
          "params": [
            "value"
          ],
          "returns": null
        },
        {
          "name": "clear",
          "op": "element_clear",
          "params": [],
