        {
          "name": "text",
          "op": "element_text",
          "params": [],
          "returns": null
        },
        {
          "name": "get_attribute",
          "op": "element_attribute",
          "params": [
            "name"
          ],
          "returns": null
        },
        {
          "name": "get_dom_attribute",
          "op": "element_attribute",
          "params": [
            "name"
          ],
          "returns": null
        },
        {
          "name": "inner_html",
          "op": "element_inner_html",
          "params": [],
          "returns": null
        },
        {
          "name": "submit",
          "impl": {
            "scope": "element",
            "returns": "void",
            "js": "function(){if(this.form){this.form.submit();}else if(this.tagName===\"FORM\"){this.submit();}}"
          }
        },
        {
          "name": "get_property",
          "params": [
            {
              "name": "name",
              "type": "String"
            }
          ],
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(n){const v=this[n];return v==null?\"\":String(v);}"
          }
        },
        {
          "name": "is_selected",
          "impl": {
            "scope": "element",
            "returns": "bool",
            "js": "function(){return this.selected===true||this.checked===true;}"
          }
        },
        {
          "name": "is_enabled",
          "impl": {
            "scope": "element",
            "returns": "bool",
            "js": "function(){return !(this.disabled===true||this.hasAttribute(\"disabled\"));}"
          }
        },
        {
          "name": "is_displayed",
          "impl": {
            "scope": "element",
            "returns": "bool",
            "js": "function(){const s=getComputedStyle(this);const r=this.getBoundingClientRect();return !!(r.width||r.height)&&s.visibility!==\"hidden\"&&s.display!==\"none\"&&s.opacity!==\"0\";}"
          }
        },
        {
          "name": "find_element",
          "params": [
            {
              "name": "selector",
              "type": "String"
            }
          ],
          "op": "element_find",
          "returns": "WebElement"
        },
        {
          "name": "find_elements",
          "params": [
            {
              "name": "selector",
              "type": "String"
            }
          ],
          "op": "element_find_all",
          "returns": "WebElement",
          "list": true
        },
        {
          "name": "value_of_css_property",
          "params": [
            {
              "name": "property_name",
              "type": "String"
            }
          ],
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(p){return getComputedStyle(this).getPropertyValue(p);}"
          }
        },
        {
          "name": "screenshot",
          "op": "element_screenshot",
          "returns": null
        },
        {
          "name": "screenshot_as_png",
          "op": "element_screenshot",
          "returns": null
        },
        {
          "name": "screenshot_as_base64",
          "op": "element_screenshot_base64",
          "returns": null
        },
        {
          "name": "tag_name",
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(){return this.tagName?this.tagName.toLowerCase():\"unknown\";}"
          }
        },
        {
          "name": "location",
          "impl": {
            "scope": "element",
            "returns": "json",
            "js": "function(){const r=this.getBoundingClientRect();return {x:r.x,y:r.y,width:r.width,height:r.height};}"
          }
        },
        {
          "name": "location_once_scrolled_into_view",
          "impl": {
            "scope": "element",
            "returns": "json",
            "js": "function(){this.scrollIntoView({block:\"center\",inline:\"center\"});const r=this.getBoundingClientRect();return {x:r.x,y:r.y};}"
          }
        },
        {
          "name": "size",
          "impl": {
            "scope": "element",
            "returns": "json",
            "js": "function(){const r=this.getBoundingClientRect();return {width:r.width,height:r.height};}"
          }
        },
        {
          "name": "rect",
          "impl": {
            "scope": "element",
            "returns": "json",
            "js": "function(){const r=this.getBoundingClientRect();return {x:r.x,y:r.y,width:r.width,height:r.height};}"
          }
        },
        {
          "name": "parent",
          "op": "element_parent",
          "returns": "WebElement"
        },
        {
          "name": "id",
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(){return this.id||'';}"
          }
        },
        {
          "name": "shadow_root",
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(){return this.shadowRoot?this.shadowRoot.innerHTML:\"\";}"
          }
        },
        {
          "name": "aria_role",
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(){return this.getAttribute(\"role\")||this.tagName.toLowerCase();}"
          }
        },
        {
          "name": "accessible_name",
          "impl": {
            "scope": "element",
            "returns": "string",
            "js": "function(){return (this.getAttribute(\"aria-label\")||this.textContent||\"\").trim();}"
          }
        }
      ]
    },
