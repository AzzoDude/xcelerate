// acme.kv - a shared, sandboxed key/value store plugin.
//
// It is a normal xcelerate plugin (imports `host`, exports `plugin`, so the host
// can load and drive it), and it *additionally* exports the typed `store`
// interface. That extra export is what other plugins import: the host wires a
// dependent plugin's `import acme:kv/store` to this component's `export store`.

package acme:kv@1.0.0;

/// The typed API `acme.kv` offers to other plugins.
interface store {
    /// Store `value` under `key`, replacing any previous value.
    set: func(key: string, value: string) -> result<_, string>;
    /// Fetch the value stored under `key`, if any.
    get: func(key: string) -> result<option<string>, string>;
    /// Remove `key`; returns whether it existed.
    delete: func(key: string) -> result<bool, string>;
    /// Every key currently stored, sorted.
    keys: func() -> list<string>;
}

world kv-plugin {
    import xcelerate:plugin/host@1.0.0;
    export xcelerate:plugin/plugin@1.0.0;
    // The extra, typed surface other plugins depend on.
    export store;
}
