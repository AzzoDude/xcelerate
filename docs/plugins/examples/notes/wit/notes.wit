// acme.notes - a plugin that DEPENDS on another plugin (acme.kv).
//
// It exports the standard plugin surface (so the host can drive it) and a typed
// `notes` API, and it *imports* `acme:kv/store` from the `acme:kv` package. That
// import has no implementation inside this component: the host satisfies it by
// wiring to the already-loaded acme.kv component.

package acme:notes@1.0.0;

/// The typed API `acme.notes` offers to other plugins.
interface notes {
    /// Save a note; returns the key it was stored under.
    save: func(title: string, body: string) -> result<string, string>;
    /// Load a note body by title.
    load: func(title: string) -> result<option<string>, string>;
    /// All note titles.
    titles: func() -> result<list<string>, string>;
}

world notes-plugin {
    import xcelerate:plugin/host@1.0.0;
    // Dependency: implemented by the acme.kv component, not by this one.
    import acme:kv/store@1.0.0;
    export xcelerate:plugin/plugin@1.0.0;
    export notes;
}
