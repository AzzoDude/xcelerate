{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AzzoDude/xcelerate/docs/plugins/plugin.schema.json",
  "title": "xcelerate plugin manifest",
  "description": "Declarative manifest for an xcelerate plugin. Third-party manifests are validated by the host before any plugin code runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "tier", "host_api"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "Unique plugin id. May not shadow a first-party plugin name such as 'stealth'."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Plugin version (semver recommended)."
    },
    "tier": {
      "enum": ["first-party", "third-party"],
      "description": "Trust tier. Plugins authored outside xcelerate must use 'third-party'."
    },
    "host_api": {
      "type": "string",
      "minLength": 1,
      "description": "Host interface range this plugin targets, e.g. '>=1.0 <2.0'."
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the sandboxed program, relative to the manifest. Required for third-party plugins."
    },
    "abi": {
      "type": "string",
      "minLength": 1,
      "description": "Sandbox ABI the plugin speaks, e.g. 'wasm32-wasi+rpc/1'."
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Operations exposed through PluginHandle::invoke."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" },
      "description": "Capabilities requested. Default-deny; first-party-only capabilities are rejected for third-party plugins."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-invocation resource budgets, clamped to the host maxima.",
      "properties": {
        "max_invoke_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000,
          "default": 30000
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576,
          "default": 1048576
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "enum": [
        "navigate",
        "query",
        "click",
        "fill",
        "type_keys",
        "wait_for",
        "wait_for_navigation",
        "get_text",
        "get_attribute",
        "evaluate",
        "cdp_proxy",
        "read_cookies",
        "write_cookies",
        "init_script",
        "screenshot",
        "network_capture",
        "launch_control",
        "binary_patch",
        "detached_spawn"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "tier": { "const": "third-party" } },
        "required": ["tier"]
      },
      "then": { "required": ["entrypoint", "ops"] }
    }
  ]
}
