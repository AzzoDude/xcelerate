// Typed plugin ABI for xcelerate plugins compiled to WebAssembly.
//
// The host implements `host`; the plugin implements the `plugin` interface.
// Op arguments and results are a single binary `payload` (MessagePack by
// convention) rather than JSON: compact, cheaper to (de)serialize, and the host
// and guest structs stay typed via `serde` + `wit-bindgen` codegen.
//
// Build a plugin against this world with `wit-bindgen`, and run it with the
// `wasmtime`-backed transport (`crates/xcelerate/src/plugin/wasm.rs`, on by
// default via the `wasm` feature; build with `--no-default-features` to disable).
package xcelerate:plugin@1.0.0;

interface types {
    /// A cookie as returned by the host.
    record cookie {
        name: string,
        value: string,
        domain: string,
        path: string,
    }

    /// A MessagePack-encoded argument/result blob.
    type payload = list<u8>;
}

/// Capability-gated functions the host exposes to the plugin. A call whose
/// capability was not granted returns an error instead of doing anything.
interface host {
    use types.{cookie, payload};

    /// Always available. Recorded in the audit log; the text is capped.
    log: func(message: string);

    /// Requires the `read_cookies` capability.
    get-cookies: func() -> result<list<cookie>, string>;

    /// Requires the `write_cookies` capability.
    set-cookie: func(cookie: cookie) -> result<_, string>;

    /// Requires the `invoke_plugin` capability. Calls another enabled plugin's
    /// op by name with a MessagePack args payload and returns its MessagePack
    /// result. This is how a plugin declares a *dependency* on another plugin:
    /// the host routes the call (honouring overrides and budgets) and records it
    /// in the audit log.
    invoke-plugin: func(plugin: string, op: string, args: payload) -> result<payload, string>;

    /// Requires the `browser` capability. Run a low-level **browser primitive**
    /// (`goto`, `click-selector`, `type-index`, `evaluate`, `cdp`, …) on this
    /// run's active page. `args` is a MessagePack argument object; the result is
    /// a MessagePack value. Deliberately not raw CDP/BiDi: the host keeps the
    /// protocol, so the `browser` plugin composes primitives into verbs and a
    /// guest is never handed a protocol message.
    browser: func(op: string, args: payload) -> result<payload, string>;

    /// Requires the `desktop` capability (Windows only). Drive a native window
    /// through UI Automation. `op` names a primitive (`launch`, `tree`,
    /// `click`, `set-value`, …) and `args` is a MessagePack argument object.
    desktop: func(op: string, args: payload) -> result<payload, string>;

    /// Requires the `core` capability. Perform a **host primitive** that is
    /// neither browser nor app: stdout, time, environment, and (later) HTTP and
    /// the filesystem. `op` names a verb (`print`, `now`, `env`, `request`, …)
    /// and `args` is a MessagePack argument object; the result is a MessagePack
    /// value. Deliberately semantic: a plugin asks the host for a primitive, so
    /// the sandbox and the audit log stay authoritative.
    core: func(op: string, args: payload) -> result<payload, string>;
}

/// What every plugin exports.
interface plugin {
    use types.{payload};

    /// Handshake: `{ name, version, ops, schema_version?, schemas? }` encoded as
    /// `payload`, checked against `plugin.json`.
    ///
    /// `schema_version` (default 0) advertises schema support; when `>= 1` the
    /// optional `schemas` map carries, per op, `{ schema, defaults }` - the JSON
    /// Schema input object (as a string) and a flat JSON object of default
    /// values (as a string). Carried inline in `describe` so legacy hosts that
    /// only read `name`/`version`/`ops` remain unaffected, and so the guest
    /// `Guest` trait is unchanged from v1.
    describe: func() -> payload;

    /// Run an op. `op` is the verb; `args` is a `payload`; the result is a
    /// `payload`.
    invoke: func(op: string, args: payload) -> result<payload, string>;
}

world plugin-world {
    import host;
    export plugin;
}
